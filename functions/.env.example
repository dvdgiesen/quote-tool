# Business details for offers and e-mails (see src/shared/company.ts).
#
# Copy this file to functions/.env and fill in your own details. functions/.env is ignored by git;
# Firebase reads it when you run `firebase deploy --only functions`.
# For the local emulator you can override single values in functions/.env.local.
#
# The values below are fictional. Without a functions/.env the functions use exactly these values,
# and owner notifications go to the example address, so set at least COMPANY_EMAIL.

COMPANY_NAME="Voorbeeld Webstudio"
COMPANY_OWNER="Jan Jansen"
COMPANY_ADDRESS="Voorbeeldstraat 1, 1234 AB Voorbeeldstad"
COMPANY_EMAIL=info@voorbeeld.example
COMPANY_PHONE="06 12345678"
COMPANY_KVK=12345678
COMPANY_VAT=NL000000000B01
COMPANY_WEBSITE=voorbeeld.example
COMPANY_QUOTE_TOOL_HOST=quote.voorbeeld.example
COMPANY_FROM_EMAIL=noreply@voorbeeld.example
COMPANY_OFFER_PREFIX=VW
